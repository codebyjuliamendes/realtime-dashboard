{
  "swagger": "2.0",
  "info": {
    "version": "1.0.0",
    "title": "Realtime Dashboard API",
    "description": "API for retrieving historical event logs"
  },
  "basePath": "/api",
  "paths": {
    "/history": {
      "get": {
        "summary": "Retrieves historical event logs",
        "parameters": [
          {
            "in": "query",
            "name": "start",
            "type": "integer",
            "description": "Start timestamp"
          },
          {
            "in": "query",
            "name": "end",
            "type": "integer",
            "description": "End timestamp"
          },
          {
            "in": "query",
            "name": "limit",
            "type": "integer",
            "description": "Limit the number of records"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "schema": {
              "type": "object",
              "properties": {
                "status": {
                  "type": "string"
                },
                "data": {
                  "type": "array",
                  "items": {
                    "type": "object"
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
