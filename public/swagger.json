{
  "openapi": "3.0.3",
  "info": {
    "title": "Realtime Dashboard API",
    "version": "2.0.0",
    "description": "Read-only API of the real-time dashboard. Live updates are pushed over a WebSocket on the same host (path `/`) as `{ \"type\": \"BATCH\", \"events\": [...] }` messages. Every event carries `source` and `isSimulated` so clients can tell real data (CoinGecko) from demo generators."
  },
  "paths": {
    "/api/history": {
      "get": {
        "summary": "Event history",
        "description": "Without `start`/`end`: the most recent `limit` events kept in memory. With `start` and `end`: events persisted in SQLite between the two timestamps (inclusive), oldest first.",
        "parameters": [
          {
            "in": "query",
            "name": "start",
            "schema": { "type": "integer", "minimum": 0 },
            "description": "Start of range, epoch milliseconds. Requires `end`."
          },
          {
            "in": "query",
            "name": "end",
            "schema": { "type": "integer", "minimum": 0 },
            "description": "End of range, epoch milliseconds. Requires `start`. Range is limited by HISTORY_MAX_RANGE_MS (default 1 h)."
          },
          {
            "in": "query",
            "name": "limit",
            "schema": { "type": "integer", "minimum": 1, "maximum": 5000, "default": 100 },
            "description": "Maximum number of events (upper bound set by HISTORY_MAX_LIMIT)."
          }
        ],
        "responses": {
          "200": {
            "description": "Events, oldest first",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": { "type": "string", "example": "success" },
                    "count": { "type": "integer" },
                    "data": { "type": "array", "items": { "$ref": "#/components/schemas/Event" } }
                  }
                }
              }
            }
          },
          "400": { "$ref": "#/components/responses/Error" },
          "429": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/api/status": {
      "get": {
        "summary": "Data sources and feed health",
        "responses": {
          "200": {
            "description": "Status of each feed",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": { "type": "string", "example": "success" },
                    "data": {
                      "type": "object",
                      "properties": {
                        "crypto": {
                          "type": "object",
                          "properties": {
                            "source": { "type": "string", "enum": ["coingecko", "demo", "off"] },
                            "state": { "type": "string", "enum": ["idle", "ok", "degraded", "off"] },
                            "lastSuccessAt": { "type": "integer", "nullable": true },
                            "lastError": { "type": "string", "nullable": true },
                            "nextRetryAt": { "type": "integer", "nullable": true }
                          }
                        },
                        "iot": {
                          "type": "object",
                          "properties": {
                            "source": { "type": "string", "enum": ["simulated", "off"] },
                            "state": { "type": "string" },
                            "isSimulated": { "type": "boolean" }
                          }
                        },
                        "retentionHours": { "type": "integer" }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/healthz": {
      "get": { "summary": "Liveness probe", "responses": { "200": { "description": "Process is alive" } } }
    },
    "/readyz": {
      "get": {
        "summary": "Readiness probe",
        "responses": {
          "200": { "description": "Ready to serve traffic" },
          "503": { "description": "Starting, shutting down or database unavailable" }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Event": {
        "type": "object",
        "required": ["type", "timestamp", "source", "isSimulated"],
        "properties": {
          "type": { "type": "string", "enum": ["CRYPTO", "IOT", "SYSTEM", "SYSTEM_ERROR"] },
          "timestamp": { "type": "integer", "description": "Epoch milliseconds when the server published the event" },
          "source": { "type": "string", "example": "coingecko", "description": "coingecko, simulator or server" },
          "isSimulated": { "type": "boolean", "description": "true when values come from a demo generator" },
          "data": {
            "type": "object",
            "description": "CRYPTO: `{ bitcoin: { usd, last_updated_at } , ... }` (last_updated_at in epoch seconds, as reported by CoinGecko). IOT: `{ temperature, humidity, cpuUsage }`."
          },
          "message": { "type": "string" }
        }
      },
      "Error": {
        "type": "object",
        "properties": { "status": { "type": "string", "example": "error" }, "message": { "type": "string" } }
      }
    },
    "responses": {
      "Error": {
        "description": "Error",
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
      }
    }
  }
}
