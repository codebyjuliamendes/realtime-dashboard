{
  "name": "realtime-dashboard",
  "version": "2.0.0",
  "description": "Real-time dashboard streaming CoinGecko crypto prices and simulated sensor telemetry over WebSockets",
  "private": true,
  "license": "MIT",
  "type": "module",
  "main": "server.js",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "npm run build && node --watch server.js",
    "build": "tailwindcss -c tailwind.config.js -i src/styles/tailwind.css -o public/css/app.css --minify",
    "build:watch": "tailwindcss -c tailwind.config.js -i src/styles/tailwind.css -o public/css/app.css --watch",
    "test": "node --test --test-reporter=spec \"test/**/*.test.js\"",
    "test:coverage": "node --test --experimental-test-coverage \"test/**/*.test.js\"",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -p tsconfig.json",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm test"
  },
  "dependencies": {
    "chart.js": "^4.6.1",
    "compression": "^1.8.2",
    "express": "^4.22.3",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "pino": "^10.4.0",
    "swagger-ui-dist": "^5.34.0",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/compression": "^1.8.1",
    "@types/express": "^4.17.25",
    "@types/node": "^22.20.5",
    "@types/ws": "^8.18.2",
    "eslint": "^9.39.5",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3"
  }
}
