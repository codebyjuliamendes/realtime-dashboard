# Copy to .env and adjust. Every variable is optional; defaults are shown.

# --- server ---
NODE_ENV=development
HOST=0.0.0.0
PORT=3001
LOG_LEVEL=info
# Express "trust proxy" (false | true | number of hops | subnet list). Set to 1 behind one reverse proxy/ingress.
TRUST_PROXY=false
SHUTDOWN_TIMEOUT_MS=10000

# --- storage (SQLite event log via node:sqlite) ---
DATA_DIR=data
DB_FILE=events.db
RETENTION_HOURS=24

# --- crypto feed ---
# coingecko = real prices from the CoinGecko public API
# demo      = synthetic random walk, clearly labelled "Simulated data" in the UI
# off       = no crypto feed
CRYPTO_SOURCE=coingecko
CRYPTO_POLL_MS=30000
COINGECKO_BASE_URL=https://api.coingecko.com/api/v3
# Optional CoinGecko demo API key (sent as x-cg-demo-api-key). Never commit real keys.
COINGECKO_API_KEY=
UPSTREAM_TIMEOUT_MS=8000

# --- sensor telemetry (no real device integration exists: simulator only) ---
IOT_SOURCE=simulated
IOT_INTERVAL_MS=250

# --- realtime / API ---
WS_BATCH_MS=50
WS_HEARTBEAT_MS=30000
# Comma-separated extra origins allowed for WebSocket upgrades and CORS (same host is always allowed).
ALLOWED_ORIGINS=
HISTORY_BUFFER_SIZE=10000
HISTORY_MAX_LIMIT=5000
HISTORY_MAX_RANGE_MS=3600000
RATE_LIMIT_PER_MINUTE=120
